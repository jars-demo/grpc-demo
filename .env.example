# Copy to .env to override defaults. Docker Compose reads .env automatically for the variables
# marked [compose]. The Python services read the others from the environment; Compose sets them
# for the containers. Every variable is validated at startup (services/common/config.py).
# Never put real secrets here - the workshop needs none.

# --- Host ports (published on 127.0.0.1 and ::1 only) [compose] ------------------------------
GRPC_TLS_HOST_PORT=50051
GRPC_MTLS_HOST_PORT=50052
GRPC_EXPIRED_HOST_PORT=50053
REST_HTTP_HOST_PORT=8080
REST_HTTPS_HOST_PORT=8443
WEB_HOST_PORT=3000

# --- Linux only: run containers as your user so they can read the 0600 key files [compose] ---
# scripts/tasks.py sets these automatically. Docker Desktop (Windows/macOS) ignores them.
# LOCAL_UID=1000
# LOCAL_GID=1000

# --- Logging [compose + services] ------------------------------------------------------------
LOG_LEVEL=INFO
# gRPC's own C-core logging (handshake failures etc.): DEBUG, INFO, ERROR
# GRPC_VERBOSITY=ERROR

# --- gRPC server -----------------------------------------------------------------------------
# Address to bind. "localhost" = 127.0.0.1 and ::1. Containers use 0.0.0.0.
GRPC_BIND_HOST=localhost
# 0 disables a listener. Plaintext is refused unless GRPC_BIND_HOST is a loopback address.
GRPC_PLAINTEXT_PORT=0
GRPC_TLS_PORT=50051
GRPC_MTLS_PORT=50052
GRPC_SERVER_CERT_FILE=certs/out/server.crt
GRPC_SERVER_KEY_FILE=certs/out/server.key
# CA that client certificates must chain to (mutual TLS listener).
GRPC_CLIENT_CA_FILE=certs/out/ca.crt
# Comma-separated client certificate Common Names allowed to call AdminService. [compose]
GRPC_ADMIN_IDENTITIES=workshop-admin
# Worker threads (each active streaming call uses one). 1-256. [compose]
GRPC_MAX_WORKERS=16
# Maximum message size in bytes, both directions. 1024 - 4194304.
GRPC_MAX_MESSAGE_BYTES=65536
GRPC_SHUTDOWN_GRACE_SECONDS=5

# --- REST API --------------------------------------------------------------------------------
REST_BIND_HOST=127.0.0.1
REST_PORT=8080
# Set both to serve HTTPS; leave both empty for HTTP.
REST_TLS_CERT_FILE=
REST_TLS_KEY_FILE=
# Maximum request body in bytes (also enforced for chunked uploads). 256 - 1048576.
REST_MAX_BODY_BYTES=16384

# --- Command-line client defaults (flags override) -------------------------------------------
GRPC_TARGET=localhost:50051
GRPC_CA_FILE=certs/out/ca.crt
# Set both for mutual TLS by default.
GRPC_CLIENT_CERT_FILE=
GRPC_CLIENT_KEY_FILE=
GRPC_DEADLINE_SECONDS=5
REST_BASE_URL=https://localhost:8443
