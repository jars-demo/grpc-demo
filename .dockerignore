# Keep the build context small and, above all, keep key material out of every image.
.git
.github
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
.env
.env.*
!.env.example

# Generated certificates and private keys: mounted at runtime, never baked in.
certs/out
**/*.key
**/*.pem
**/*.p12

challenge/work

frontend/node_modules
frontend/.next
frontend/out
tests
